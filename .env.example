# GEMINI_API_KEY: Optional Gemini API key (if configured in Secrets panel).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------- MongoDB Storage ----------------
# Primary MongoDB connection URI (Atlas or self-hosted). Never expose to frontend.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="smart_travel_planner"
# Optional local/dev fallback using mongodb-memory-server when MONGODB_URI is unset (auto-disabled on Vercel/production)
USE_MEMORY_MONGODB="true"

# ---------------- Admin & Ingestion Protection ----------------
# Secret header key (x-admin-key or Authorization: Bearer <key>) required for /api/admin/ingestion/*
ADMIN_API_KEY="CHANGE_ME_STRONG_ADMIN_SECRET"
# Optional comma-separated list of authorized administrator emails
ADMIN_EMAILS="admin@example.com"

# ---------------- Worldwide Open Data Sources (Free Default) ----------------
OVERTURE_STAC_URL="https://stac.overturemaps.org/catalog.json"
TRAVELTYPE_API_BASE_URL="https://traveltype.app"
WIKIDATA_SPARQL_URL="https://query.wikidata.org/sparql"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OSRM_API_URL="https://router.project-osrm.org/route/v1/driving"
OPEN_METEO_GEOCODE_URL="https://geocoding-api.open-meteo.com/v1/search"
OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"

# ---------------- Optional Provider (Disabled by Default) ----------------
# OpenTripMap free tier is limited to non-commercial use; keep disabled unless licensed/needed.
OPENTRIPMAP_ENABLED="false"
OPENTRIPMAP_API_KEY=""

# ---------------- ML Recommendation Ranker ----------------
# Path to exported LightGBM LambdaMART ONNX artifact (generated via ml/train_ranker.py)
MODEL_ONNX_PATH="ml/artifacts/attraction_ranker.onnx"
